KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Unreachable on purpose: no test may depend on the real provider, its credentials or the network.
# A test that needs an answer replaces `ai.platform.generic.default` with MockPlatformFactory.
