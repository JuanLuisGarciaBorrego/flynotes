{% extends 'base.html.twig' %}

{% block title %}Sign in with your code · FlyNotes{% endblock %}

{% block stylesheets %}<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">{% endblock %}

{% block clouds %}{% endblock %}

{% block header_actions %}
    {% if me %}
        {{ parent() }}
    {% else %}
        <a href="{{ path('app_registration', return_plane ? {plane: return_plane} : {}) }}" class="btn flex min-h-11 items-center rounded-full bg-ink px-[18px] text-[15px] font-semibold text-white no-underline hover:text-white">Sign up</a>
    {% endif %}
{% endblock %}

{% block main_class %}relative z-10 w-full grow px-[clamp(14px,4vw,24px)] pb-10 pt-2{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
<div id="recovery" class="mx-auto flex w-full max-w-[520px] flex-col gap-[22px]" data-continue-url="{{ path('app_home', return_plane ? {plane: return_plane} : {}) }}">
    <header class="flex flex-col gap-1.5 text-center">
        <p class="m-0 text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">Welcome back</p>
        <h1 class="m-0 font-display text-[clamp(28px,4.4vw,40px)] font-bold leading-[1.05] tracking-[-0.03em]">Sign in with your code</h1>
        <p class="m-0 text-base text-ink-soft">The secret code you got when you created your identity.</p>
    </header>

    <form id="recovery-form" class="paper-card" novalidate>
        <div class="airmail-paper h-[5px]" aria-hidden="true"></div>
        <div class="flex flex-col gap-4 p-[clamp(20px,4vw,30px)]">
            <div class="flex flex-col gap-2">
                <label for="code" class="font-label text-[11px] font-bold tracking-[0.12em] text-ink-muted">RECOVERY CODE</label>
                <input id="code" name="code" type="text" required autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="19"
                       placeholder="XXXX-XXXX-XXXX-XXXX" aria-describedby="code-help" class="auth-code">
                <p id="code-help" class="m-0 text-[13px] text-ink-muted">16 letters and numbers. Dashes are added for you.</p>
                <p id="code-error" class="m-0 hidden text-sm text-[#B91C1C]" role="alert"></p>
            </div>

            <button id="submit" type="submit" disabled class="auth-primary">
                <svg id="spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                <span id="submit-label">Sign in</span>
            </button>

            <p class="m-0 flex items-center gap-2 text-[13px] text-ink-muted">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="16" height="11" x="4" y="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                Your code is never shown in links or stored in your browser.
            </p>
        </div>
    </form>

    <p class="m-0 text-center text-[15px] text-ink-soft">Lost your code? You can <a href="{{ path('app_registration', return_plane ? {plane: return_plane} : {}) }}" class="font-semibold">create a new identity</a>.</p>
</div>
{% endblock %}
