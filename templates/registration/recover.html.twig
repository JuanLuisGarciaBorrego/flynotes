{% extends 'base.html.twig' %}

{% block title %}Recover your identity · FlyNotes{% endblock %}

{% block body %}
<div id="recovery" class="mx-auto -mt-4 w-full max-w-md sm:mt-0">
    <div class="rounded-3xl border border-amber-100 bg-gradient-to-b from-white to-amber-50/60 p-6 shadow-sm sm:p-8">
        <div id="recovery-form-section">
            <header class="text-center">
                <p class="text-5xl" aria-hidden="true">🔑</p>
                <h1 class="mt-3 text-3xl font-bold tracking-tight">Recover your identity</h1>
                <p class="mt-2 text-stone-600">Enter the personal code you saved when you created your identity.</p>
            </header>

            <form id="recovery-form" class="mt-8 space-y-5" novalidate>
                <p id="form-error" class="hidden rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-800" role="alert"></p>

                <div>
                    <label for="code" class="block text-sm font-medium text-stone-700">Recovery code</label>
                    <input id="code" name="code" type="text" required maxlength="64" autocomplete="off" autocapitalize="characters" spellcheck="false"
                           placeholder="K7M9-Q2RP-V4TX-N8WC"
                           class="mt-1 block w-full rounded-xl border border-stone-300 bg-white px-4 py-3 font-mono tracking-widest text-stone-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-300">
                </div>

                <button id="submit" type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-full bg-sky-600 px-6 py-3 font-medium text-white shadow-sm transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 disabled:cursor-not-allowed disabled:bg-sky-400">
                    <svg id="spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
                    <span id="submit-label">Recover my identity</span>
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-stone-500">
                Don't have a code?
                <a href="{{ path('app_registration', return_plane ? {plane: return_plane} : {}) }}" class="font-medium text-sky-700 underline hover:text-sky-800">Create a new identity</a>
            </p>
        </div>

        <section id="recovery-done" class="hidden text-center" aria-live="polite">
            <p id="done-emoji" class="text-6xl" aria-hidden="true"></p>
            <h2 class="mt-4 text-2xl font-bold tracking-tight">Identity recovered!</h2>
            <p class="mt-2 text-lg">Welcome back, <span id="done-name" class="font-semibold"></span></p>
            {% if return_plane %}
                <a id="continue" href="{{ path('app_home', {plane: return_plane}) }}" class="mt-6 flex w-full items-center justify-center gap-2 rounded-full bg-sky-600 px-6 py-4 text-lg font-bold text-white shadow-md transition hover:bg-sky-700 focus:outline-none focus:ring-4 focus:ring-sky-300 focus:ring-offset-2">
                    Back to the plane to add my stamp
                </a>
                <a href="{{ path('app_paper_plane_new') }}" class="mt-3 block text-sm font-medium text-sky-700 underline">Write a message</a>
            {% else %}
                <a id="continue" href="{{ path('app_paper_plane_new') }}" class="mt-6 flex w-full items-center justify-center gap-2 rounded-full bg-amber-500 px-6 py-4 text-lg font-bold text-white shadow-md transition hover:bg-amber-600 focus:outline-none focus:ring-4 focus:ring-amber-300 focus:ring-offset-2">
                    Write a message
                </a>
            {% endif %}
            <a href="{{ path('app_home') }}" class="mt-3 block text-sm font-medium text-sky-700 underline">Back to home</a>
        </section>
    </div>
</div>
{% endblock %}
