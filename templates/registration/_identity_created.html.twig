{# Shown once, right after the POST and with the same URL: assets/js/registration.js fills it. The code only lives in memory. #}
<section id="identity-created" hidden aria-labelledby="created-title" class="mx-auto w-full max-w-[600px]" data-continue-url="{{ path('app_home', return_plane ? {plane: return_plane} : {}) }}">
    <div class="paper-card">
        <div class="airmail-paper h-[5px]" aria-hidden="true"></div>
        <div class="flex flex-col items-center gap-4 p-[clamp(16px,4vw,34px)] text-center">
            <span id="created-emoji" aria-hidden="true" class="flex size-[84px] items-center justify-center rounded-full bg-accent-tint text-[46px]"></span>
            <div class="flex w-full flex-col gap-1.5">
                <h1 id="created-title" tabindex="-1" class="m-0 break-words font-display text-[clamp(26px,4vw,34px)] font-bold leading-[1.08] tracking-[-0.02em] outline-none"></h1>
                <p class="m-0 flex flex-wrap items-center justify-center gap-1.5 text-base text-ink-soft">
                    <span id="created-animal"></span>
                    <span class="flex items-center gap-1.5">
                        <img id="created-flag" src="" alt="" hidden class="h-[15px] w-5 rounded-[2px] object-cover">
                        <span id="created-country"></span>
                    </span>
                </p>
            </div>

            <div class="flex flex-col gap-2.5 self-stretch rounded-lg border-2 border-dashed border-accent bg-[#FFFBF8] p-3.5 text-left sm:p-[18px]">
                <span class="font-label text-[11px] font-bold tracking-[0.12em] text-accent-dark">YOUR SECRET RECOVERY CODE</span>
                <output id="created-code" aria-label="Recovery code" class="break-all font-label text-[clamp(20px,4.4vw,28px)] font-bold tracking-[.08em]"></output>
                <div class="flex flex-wrap gap-2">
                    <button id="copy" type="button" class="auth-chip border-ink">
                        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                        <span id="copy-label">Copy code</span>
                    </button>
                    <button id="download" type="button" class="auth-chip border-line">
                        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="m7 10 5 5 5-5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/></svg>
                        <span id="download-label">Download .txt</span>
                    </button>
                </div>
                <p id="code-status" class="sr-only m-0 text-sm text-[#B91C1C]" role="status"></p>
            </div>

            <p role="note" class="m-0 flex gap-2.5 self-stretch rounded-lg bg-accent-tint px-3.5 py-3 text-left text-sm leading-[1.45] text-[#7C2D12]">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                <span><strong>You'll only see it once.</strong> It's your only key: there's no email or password to recover it. Keep it somewhere safe and don't share it.</span>
            </p>

            <label class="flex min-h-11 cursor-pointer items-center gap-3 self-stretch text-left text-[15px] font-medium">
                <input id="code-saved" type="checkbox" class="size-[22px] shrink-0 accent-accent">
                I've saved my code somewhere safe
            </label>

            <button id="continue" type="button" disabled class="auth-primary self-stretch">Continue to the sky</button>
        </div>
    </div>
</section>
