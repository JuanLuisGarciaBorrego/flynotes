{% extends 'base.html.twig' %}

{% block title %}My planes · FlyNotes{% endblock %}

{% block clouds %}{% endblock %}

{% block main_class %}relative z-10 mx-auto w-full max-w-[860px] grow px-4 pb-14 pt-4 sm:px-6 sm:pb-20 sm:pt-6{% endblock %}

{% block body %}
{% set send_icon %}<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>{% endset %}
{% set eye_icon %}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>{% endset %}
{% set stamp_icon %}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22h14"/><path d="M19.27 13.73A2.5 2.5 0 0 0 17.5 13h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1.5c0-.66-.26-1.3-.73-1.77Z"/><path d="M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-3-3c-1.66 0-3 1-3 3s1 2 1 3.5V13"/></svg>{% endset %}
{# Presentation only: assets/js/my-planes.js fills it from GET /api/me/paper_planes (pages of 20) and
   GET /api/me/paper_planes/stats. Every state below starts hidden except the loader. #}

<div id="my-planes-page" class="flex flex-col gap-6 sm:gap-8" data-home-url="{{ path('app_home') }}" data-registration-url="{{ path('app_registration') }}">
    <a href="{{ path('app_home') }}" class="flex min-h-11 items-center self-start text-[15px] font-semibold text-ink no-underline hover:text-ink hover:underline">← Back to the sky</a>

    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
        <div class="flex flex-col gap-2">
            <h1 class="m-0 font-display text-[32px] font-bold leading-[1.04] tracking-[-0.03em] sm:text-[clamp(32px,4.6vw,46px)]">My planes</h1>
            <p class="m-0 text-base leading-normal text-ink-soft sm:text-[17px]">The messages you've launched into the world, and how far they've flown.</p>
        </div>
        <a hidden data-when-planes href="{{ path('app_paper_plane_new') }}" class="btn flex min-h-[52px] shrink-0 items-center justify-center gap-2.5 rounded-full bg-accent px-6 text-[17px] font-semibold text-white no-underline hover:bg-accent-dark hover:text-white">{{ send_icon|raw }} Launch another plane</a>
    </header>

    <p id="my-planes-loading" class="loading-dots m-0 py-12 text-center text-base font-medium text-ink-soft" role="status">Loading your planes</p>
    <noscript><p class="m-0 text-center text-base text-ink-soft">Turn on JavaScript to see your planes.</p></noscript>

    <section id="my-planes-error" hidden role="alert" class="flex flex-col items-center gap-4 rounded-md border border-line-soft bg-white px-6 py-10 text-center shadow-paper">
        <p data-error-message class="m-0 font-display text-xl font-semibold">We couldn't load your planes.</p>
        <button type="button" data-retry class="btn min-h-11 cursor-pointer rounded-full border-[1.5px] border-ink bg-white px-5 text-[15px] font-semibold text-ink">Try again</button>
    </section>

    <section id="my-planes-empty" hidden class="flex flex-col items-center gap-4 rounded-md border-[1.5px] border-dashed border-line bg-white/70 px-6 py-12 text-center sm:px-12 sm:py-16">
        <svg aria-hidden="true" viewBox="0 0 160 70" fill="none" stroke-linejoin="round" class="h-auto w-[180px] sm:w-[220px]">
            <path d="M4 52 C 34 60, 66 40, 98 44" stroke="#8FA3BA" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round"/>
            <path d="M98 30 L158 6 L118 42 Z" fill="#C2410C" stroke="#14213D" stroke-width="1.6"/>
            <path d="M118 42 L158 6 L126 62 Z" fill="#D3DEE9" stroke="#14213D" stroke-width="1.6"/>
            <path d="M118 42 L121 54 L126 62" stroke="#14213D" stroke-width="1.6"/>
        </svg>
        <h2 class="m-0 font-display text-2xl font-bold sm:text-[28px]">You haven't launched any planes yet</h2>
        <p class="m-0 max-w-[42ch] text-base leading-normal text-ink-soft">Write something you'd love someone to read today, and let the world find it.</p>
        <a href="{{ path('app_paper_plane_new') }}" class="btn mt-2 flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-accent px-6 text-[17px] font-semibold text-white no-underline hover:bg-accent-dark hover:text-white">{{ send_icon|raw }} Launch my first plane</a>
    </section>

    {# Totals over all the planes (not the current page). "—" until they arrive or if they fail. #}
    <dl id="my-planes-summary" hidden data-when-planes aria-busy="true" class="m-0 grid grid-cols-3 overflow-hidden rounded-md border border-line-soft bg-white shadow-paper">
        {% for item in [
            {stat: 'totalPlanes', label: 'planes launched'},
            {stat: 'totalViews', label: 'times read'},
            {stat: 'totalCountries', label: 'countries that stamped'},
        ] %}
            <div class="flex flex-col-reverse gap-1 px-3 py-4 sm:px-6 sm:py-5 {{ not loop.first ? 'border-l border-line-soft' }}">
                <dt class="text-[13px] leading-snug text-ink-muted sm:text-sm">{{ item.label }}</dt>
                <dd class="m-0 font-display text-[28px] font-extrabold leading-none" data-stat="{{ item.stat }}">—</dd>
            </div>
        {% endfor %}
    </dl>

    <ul id="my-planes" hidden data-when-planes aria-label="Your planes" tabindex="-1" class="m-0 flex list-none flex-col gap-5 p-0 outline-none"></ul>

    <nav id="my-planes-pagination" hidden aria-label="Pages of your planes" class="flex items-center justify-between gap-4">
        <button type="button" data-page="previous" class="btn flex min-h-11 shrink-0 cursor-pointer items-center whitespace-nowrap rounded-full border-[1.5px] border-ink bg-white px-4 text-[15px] font-semibold text-ink disabled:cursor-default disabled:opacity-40">← Newer</button>
        <p class="m-0 text-center text-sm text-ink-muted" data-page-label aria-live="polite"></p>
        <button type="button" data-page="next" class="btn flex min-h-11 shrink-0 cursor-pointer items-center whitespace-nowrap rounded-full border-[1.5px] border-ink bg-white px-4 text-[15px] font-semibold text-ink disabled:cursor-default disabled:opacity-40">Older →</button>
    </nav>

    {# One card, cloned per plane. Participant data only ever goes in through textContent/attributes. #}
    <template id="my-plane-card">
        <li>
            <article class="overflow-hidden rounded-md border border-line-soft bg-white shadow-paper">
                <div class="airmail-paper h-1" aria-hidden="true"></div>
                <div class="flex flex-col gap-4 p-5 sm:gap-5 sm:px-7 sm:py-6">
                    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                        <span data-status="flying" class="inline-flex items-center gap-2 rounded-full bg-[#ECFDF3] px-3 py-1 text-[13px] font-semibold text-[#166534]">
                            <span class="size-2 rounded-full bg-[#16A34A]" aria-hidden="true"></span>
                            In flight
                        </span>
                        <span data-status="waiting" class="inline-flex items-center rounded-full bg-[#EEF3F8] px-3 py-1 text-[13px] font-semibold text-ink-muted">Waiting for its first reader</span>
                        <time class="text-[13px] text-ink-muted sm:text-sm"></time>
                    </div>

                    <p data-message class="m-0 whitespace-pre-line break-words font-display text-xl font-semibold leading-[1.28] tracking-[-0.015em] sm:text-2xl"></p>

                    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 border-t-[1.5px] border-dashed border-line pt-4">
                        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[15px] font-medium text-ink-soft">
                            <span data-views class="inline-flex items-center gap-1.5">{{ eye_icon|raw }} <span data-count></span></span>
                            <span data-stamps class="inline-flex items-center gap-1.5">{{ stamp_icon|raw }} <span data-count></span></span>
                        </div>

                        <div class="flex flex-wrap items-center gap-x-5 gap-y-3 max-sm:w-full max-sm:justify-between">
                            <span data-no-stamps class="text-sm text-ink-muted">No stamps yet</span>
                            {# Last 4 stamps, overlapped and slightly tilted like a passport page (stamp.js). #}
                            <ul data-mini-stamps class="m-0 flex list-none items-center p-0 pl-4" aria-label="Latest stamps"></ul>
                            {# Without the modal it opens the plane over the home, which reopens ?plane=<uuid>. #}
                            <a data-open-plane class="btn flex min-h-11 items-center rounded-full border-[1.5px] border-ink bg-white px-4 text-[15px] font-semibold text-ink no-underline hover:text-ink">Follow its journey →</a>
                        </div>
                    </div>
                </div>
            </article>
        </li>
    </template>

    {{ include('paper_plane/_dialog.html.twig') }}
</div>
{% endblock %}
