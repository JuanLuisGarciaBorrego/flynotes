{% extends 'base.html.twig' %}

{% block title %}New plane · FlyNotes{% endblock %}

{# Only for technical labels, here FROM/TO: the pages without any do not load it. #}
{% block stylesheets %}<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">{% endblock %}

{% block body %}
{% set me = current_participant() %}
{% set message_min = constant('App\\Entity\\PaperPlane::MESSAGE_MIN_LENGTH') %}
{% set message_max = constant('App\\Entity\\PaperPlane::MESSAGE_MAX_LENGTH') %}
{% set sparks = [
    {label: 'Something kind', text: 'To whoever reads this: '},
    {label: 'A memory', text: 'I still remember '},
    {label: 'A small win', text: 'Today I finally '},
] %}
<div id="paper-plane-new" class="mx-auto flex w-full max-w-[720px] flex-col gap-6">
    <header class="flex flex-col items-center gap-2 text-center">
        <p class="m-0 text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">New plane</p>
        <h1 class="m-0 font-display text-[clamp(28px,5vw,42px)] font-bold leading-[1.1] tracking-[-0.02em]">What do you want to send into the world?</h1>
    </header>

    <div class="relative">
        <form id="paper-plane-form" novalidate class="launch-sheet overflow-hidden rounded-[6px] border border-line-soft bg-white">
            <div class="airmail-paper h-[5px]" aria-hidden="true"></div>
            <div class="flex flex-col gap-4 p-5 sm:gap-5 sm:p-8">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <p class="m-0 flex flex-wrap items-baseline gap-x-2 font-label text-xs font-medium text-ink-muted">FROM <span class="break-words font-sans text-sm font-semibold text-ink"><span aria-hidden="true">{{ me.emoji }}</span> {{ me.name }}{% if me.countryCode %} · <span id="from-flag" data-country-code="{{ me.countryCode }}" aria-hidden="true"></span> <abbr title="{{ me.countryCode|country_name('en') }}" class="no-underline">{{ me.countryCode }}</abbr>{% endif %}</span></p>
                    <p class="m-0 flex flex-wrap items-baseline gap-x-2 font-label text-xs font-medium text-ink-muted">TO <span class="font-sans text-sm font-semibold text-ink">someone, somewhere</span></p>
                </div>

                <div>
                    <label for="message" class="sr-only">Your message</label>
                    <textarea id="message" name="message" required minlength="{{ message_min }}" data-max-length="{{ message_max }}" aria-describedby="message-error message-count"
                              placeholder="Write something someone, somewhere, might need to read today…"
                              class="launch-lines block min-h-[210px] w-full resize-none border-0 p-0 font-display text-[clamp(20px,3vw,24px)] font-medium leading-[42px] text-ink outline-none placeholder:text-ink-muted"></textarea>
                    <p id="message-error" class="m-0 mt-2 hidden text-sm text-[#B91C1C]"></p>
                </div>

                <div id="message-sparks" role="group" aria-labelledby="message-sparks-label" class="flex flex-wrap items-center gap-2">
                    <span id="message-sparks-label" class="text-sm text-ink-muted">Need a spark?</span>
                    {% for spark in sparks %}
                        <button type="button" data-spark="{{ spark.text }}" class="btn h-9 cursor-pointer rounded-full border-0 bg-[#F4F7FA] px-3.5 text-sm font-medium text-ink hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">{{ spark.label }}</button>
                    {% endfor %}
                </div>

                <p id="form-error" class="m-0 hidden rounded-md bg-rose-50 px-3 py-2 text-sm text-[#B91C1C]" role="alert"></p>

                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-dashed border-line pt-4">
                    <div id="message-counter" class="launch-counter flex items-center gap-2.5 text-sm">
                        <svg aria-hidden="true" width="30" height="30" viewBox="0 0 30 30" fill="none" stroke-width="3" class="shrink-0">
                            <circle cx="15" cy="15" r="13" stroke="#E4EAF1"/>
                            <circle id="message-ring" cx="15" cy="15" r="13" stroke="currentColor" stroke-linecap="round" stroke-dasharray="81.68" stroke-dashoffset="81.68" transform="rotate(-90 15 15)"/>
                        </svg>
                        <span id="message-count" aria-live="polite">{{ message_max }} characters left</span>
                    </div>
                    <button id="submit" type="submit" disabled
                            class="btn flex h-[52px] cursor-pointer items-center justify-center gap-2.5 rounded-full border-0 bg-accent px-6 text-[17px] font-semibold text-white hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:bg-[#E7B9A5] disabled:hover:bg-[#E7B9A5] max-sm:w-full">
                        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
                        <span id="submit-label">Fold &amp; launch</span>
                    </button>
                </div>
            </div>
        </form>

        {# What the sheet turns into when it is launched (assets/js/paper-plane.js). #}
        <svg class="launch-plane" aria-hidden="true" viewBox="0 0 64 48" fill="none" stroke="#14213D" stroke-width="1.5" stroke-linejoin="round"><path d="M3 20 L61 4 L23 30 Z" fill="#C2410C"/><path d="M23 30 L61 4 L31 44 Z" fill="#FFFFFF"/><path d="M23 30 L26 40 L31 44"/></svg>
        <p id="launch-status" role="status" class="pointer-events-none absolute inset-x-0 top-1/2 m-0 -translate-y-1/2 text-center font-display text-[clamp(22px,4vw,30px)] font-bold"></p>
    </div>

    <p class="m-0 flex items-start justify-center gap-2 text-center text-sm text-ink-muted">
        <svg aria-hidden="true" class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <span>Once it takes off, it can't be edited. Only your nickname and country travel with it.</span>
    </p>
</div>

{# Human in the loop after launching: choose and approve an AI version, or discard them all (driven by assets/js/paper-plane.js).
   Escape or closing without deciding publishes nothing: the plane already flies with the original only. #}
{% set ai_pad = 'p-[clamp(20px,4.5vw,32px)]' %}
{% set ai_focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent' %}
{% set ai_back = 'btn flex h-12 items-center justify-center rounded-full bg-ink px-6 text-base font-semibold text-white no-underline hover:text-white ' ~ ai_focus %}
<dialog id="ai-dialog" aria-labelledby="ai-title"
        class="ai-dialog m-auto outline-none max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-[580px] overflow-y-auto rounded-[10px] border-0 bg-white p-0 text-ink shadow-[0_30px_60px_-28px_rgba(10,18,36,.65)] backdrop:bg-[rgba(20,33,61,.42)]">
    <div class="airmail-paper h-[5px]" aria-hidden="true"></div>
    <button type="button" data-ai-close aria-label="Close without the AI version"
            class="absolute right-3.5 top-3.5 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-ink-muted hover:text-ink disabled:cursor-not-allowed disabled:text-[#A9B8C9] {{ ai_focus }}">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <div data-ai-view="review" class="flex flex-col gap-5 {{ ai_pad }}">
        <header class="flex flex-col gap-2 pr-12">
            <p class="m-0 flex items-center gap-2 text-sm font-semibold text-[#166534]"><span class="h-2 w-2 shrink-0 rounded-full bg-[#16A34A]" aria-hidden="true"></span>Your plane is flying</p>
            <h1 id="ai-title" tabindex="-1" class="m-0 font-display text-[clamp(23px,5vw,28px)] font-bold leading-[1.15] tracking-[-0.015em] focus:outline-none">The AI wrote its own take. Should it fly too?</h1>
        </header>

        <section aria-labelledby="ai-yours-label" class="rounded-lg bg-[#F4F7FA] px-4 py-3">
            <h2 id="ai-yours-label" class="m-0 text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Yours</h2>
            <p id="ai-original" class="m-0 mt-1 whitespace-pre-line break-words text-base leading-normal"></p>
        </section>

        <section id="ai-version" aria-labelledby="ai-version-label" class="rounded-lg border-[1.5px] border-line bg-white p-[18px] data-[generating=true]:border-[#F3C9B3] data-[generating=true]:bg-[#FFFBF8]">
            <div class="flex flex-wrap items-center gap-2">
                <svg aria-hidden="true" class="shrink-0 text-accent" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
                <h2 id="ai-version-label" class="m-0 text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">AI version</h2>
                <span id="ai-tone" class="hidden rounded-full bg-accent-tint px-2.5 py-0.5 text-[13px] font-medium text-accent-dark"></span>
            </div>
            <p id="ai-proposal" aria-live="polite" class="m-0 mt-3 whitespace-pre-line break-words font-display text-[clamp(19px,4vw,22px)] font-semibold leading-[1.3]"></p>
            <p id="ai-none" class="m-0 mt-3 hidden text-[15px] leading-normal text-ink-soft">Your plane is flying with your message. You can ask the AI to try again, or simply leave it as it is.</p>
            {# Blocking loading state while another version is written (assets/js/paper-plane.js). #}
            <div id="ai-generating" class="mt-3 hidden space-y-3">
                <div class="flex items-center gap-2.5">
                    <svg class="h-5 w-5 shrink-0 motion-safe:animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#C2410C" stroke-opacity=".25" stroke-width="3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="#C2410C" stroke-width="3" stroke-linecap="round"/></svg>
                    <p id="ai-generating-step" role="status" aria-live="polite" class="m-0 text-[15px] font-medium text-ink">Reading your message…</p>
                </div>
                <div class="space-y-2" aria-hidden="true">
                    <div class="ai-skeleton h-4 w-[94%] rounded bg-[#E2E8F0]"></div>
                    <div class="ai-skeleton h-4 w-[82%] rounded bg-[#E2E8F0]"></div>
                    <div class="ai-skeleton h-4 w-[56%] rounded bg-[#E2E8F0]"></div>
                </div>
                <p class="m-0 text-[13px] text-ink-muted">This can take up to 30 seconds.</p>
            </div>
        </section>

        <p id="ai-error" class="m-0 hidden rounded-md bg-rose-50 px-3 py-2 text-sm text-rose-800" role="alert"></p>

        <div class="flex flex-wrap-reverse items-center justify-between gap-x-4 gap-y-3">
            <button type="button" data-ai-action="reject"
                    class="min-h-11 cursor-pointer rounded border-0 bg-transparent px-1 text-[15px] font-medium text-ink-soft underline underline-offset-4 hover:text-accent disabled:cursor-not-allowed disabled:text-[#A9B8C9] disabled:hover:text-[#A9B8C9] {{ ai_focus }}">No, only mine</button>
            <button type="button" data-ai-leave
                    class="hidden min-h-11 cursor-pointer rounded border-0 bg-transparent px-1 text-[15px] font-medium text-ink-soft underline underline-offset-4 hover:text-accent disabled:cursor-not-allowed disabled:text-[#A9B8C9] disabled:hover:text-[#A9B8C9] {{ ai_focus }}">Back to the sky</button>
            <div class="flex grow flex-wrap-reverse justify-end gap-3 sm:grow-0">
                <button type="button" data-ai-action="retry"
                        class="btn inline-flex h-12 grow cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-full border-[1.5px] border-line bg-white px-5 text-[15px] font-semibold text-ink hover:border-ink-muted disabled:cursor-not-allowed disabled:border-line disabled:bg-[#F4F7FA] disabled:text-[#A9B8C9] sm:grow-0 {{ ai_focus }}">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
                    <span data-ai-label>Another version</span>
                </button>
                <button type="button" data-ai-action="accept"
                        class="btn inline-flex h-12 grow cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-full border-0 bg-accent px-6 text-[15px] font-semibold text-white hover:bg-accent-dark disabled:cursor-not-allowed disabled:bg-[#E7B9A5] disabled:hover:bg-[#E7B9A5] sm:grow-0 {{ ai_focus }}">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                    <span data-ai-label>Let it fly too</span>
                </button>
            </div>
        </div>

        <p id="ai-hold" class="m-0 hidden items-center gap-2 rounded-md bg-[#FDF0E9] px-3 py-2.5 text-sm text-[#7C2D12]">
            <svg aria-hidden="true" class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Hold on, the AI is writing. You can decide as soon as it's ready.
        </p>

        <p class="m-0 flex items-center gap-2 border-t border-[#EEF3F8] pt-4 text-[13px] text-ink-muted">
            <svg aria-hidden="true" class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            Nothing written by the AI flies without your OK.
        </p>
    </div>

    <div data-ai-view="accepted" class="flex hidden flex-col items-center gap-3 text-center {{ ai_pad }}">
        <svg aria-hidden="true" width="200" height="96" viewBox="0 0 200 96" fill="none" stroke-linejoin="round">
            <path d="M6 70 C 40 78, 70 60, 104 50" stroke="#8FA3BA" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round"/>
            <path d="M6 86 C 44 92, 76 74, 108 62" stroke="#C2410C" stroke-opacity=".55" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round"/>
            <path d="M110 40 L194 12 L140 58 Z" fill="#C2410C" stroke="#14213D" stroke-width="1.8"/>
            <path d="M140 58 L194 12 L150 84 Z" fill="#D3DEE9" stroke="#14213D" stroke-width="1.8"/>
            <path d="M140 58 L144 74 L150 84" stroke="#14213D" stroke-width="1.8"/>
        </svg>
        <h1 tabindex="-1" data-ai-final-title class="m-0 font-display text-[clamp(23px,5vw,28px)] font-bold leading-[1.15] tracking-[-0.015em] focus:outline-none">Both versions are flying</h1>
        <p class="m-0 max-w-[40ch] text-base leading-normal text-ink-soft">Your plane carries your message and the AI's take, side by side. Whoever finds it reads both.</p>
        <section aria-labelledby="ai-final-yours-label" class="w-full rounded-lg bg-[#F4F7FA] px-4 py-3 text-left">
            <h2 id="ai-final-yours-label" class="m-0 text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Yours</h2>
            <p data-ai-final-original class="m-0 mt-1 whitespace-pre-line break-words text-base leading-normal"></p>
        </section>
        <section aria-labelledby="ai-final-version-label" class="w-full rounded-lg border-[1.5px] border-line bg-white p-[18px] text-left">
            <div class="flex flex-wrap items-center gap-2">
                <h2 id="ai-final-version-label" class="m-0 text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">AI version · approved by you</h2>
                <span id="ai-final-tone" class="hidden rounded-full bg-accent-tint px-2.5 py-0.5 text-[13px] font-medium text-accent-dark"></span>
            </div>
            <p id="ai-final-message" class="m-0 mt-3 whitespace-pre-line break-words font-display text-[clamp(19px,4vw,22px)] font-semibold leading-[1.3]"></p>
        </section>
        <a href="{{ path('app_home') }}" class="mt-2 {{ ai_back }}">Back to the sky</a>
    </div>

    <div data-ai-view="rejected" class="flex hidden flex-col items-center gap-3 text-center {{ ai_pad }}">
        <svg aria-hidden="true" width="160" height="80" viewBox="0 0 160 80" fill="none" stroke-linejoin="round">
            <path d="M4 60 C 34 68, 62 52, 92 46" stroke="#8FA3BA" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round"/>
            <path d="M96 36 L156 12 L116 52 Z" fill="#C2410C" stroke="#14213D" stroke-width="1.8"/>
            <path d="M116 52 L156 12 L124 70 Z" fill="#D3DEE9" stroke="#14213D" stroke-width="1.8"/>
            <path d="M116 52 L119 63 L124 70" stroke="#14213D" stroke-width="1.8"/>
        </svg>
        <h1 tabindex="-1" data-ai-final-title class="m-0 font-display text-[clamp(23px,5vw,28px)] font-bold leading-[1.15] tracking-[-0.015em] focus:outline-none">Only yours is flying</h1>
        <p class="m-0 text-base leading-normal text-ink-soft">The AI versions were discarded.</p>
        <section aria-labelledby="ai-rejected-yours-label" class="w-full rounded-lg bg-[#F4F7FA] px-4 py-3 text-left">
            <h2 id="ai-rejected-yours-label" class="m-0 text-xs font-semibold uppercase tracking-[0.06em] text-ink-muted">Yours</h2>
            <p data-ai-final-original class="m-0 mt-1 whitespace-pre-line break-words text-base leading-normal"></p>
        </section>
        <a href="{{ path('app_home') }}" class="mt-2 {{ ai_back }}">Back to the sky</a>
    </div>
</dialog>
{% endblock %}
