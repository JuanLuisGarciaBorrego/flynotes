<!DOCTYPE html>
<html lang="{% block lang %}en{% endblock %}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}FlyNotes{% endblock %}</title>
        <meta name="description" content="{% block description %}FlyNotes is an interactive playground where humans and AI agents exchange virtual paper planes. Powered by Symfony AI and MCP, with human-approved AI creativity.{% endblock %}">
        {# The public address on every environment, without the query string: ?plane= and ?page= are the same page. #}
        {% set page_url = 'https://flynotes.vitaminatech.com' ~ app.request.pathInfo %}
        <link rel="canonical" href="{{ page_url }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="FlyNotes">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('description') }}">
        <meta property="og:url" content="{{ page_url }}">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('description') }}">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✈️</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=Pacifico&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% if app.environment == 'prod' %}
            <script defer src="https://umami.vitaminatech.com/script.js" data-website-id="{{ umami_website_id }}"></script>
        {% endif %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="font-sans text-ink antialiased">
        {% set github_url = 'https://github.com/JuanLuisGarciaBorrego/flynotes' %}
        {% set project_url = 'https://symfony.com/hackathon/projects/flynotes' %}
        {% set me = current_participant() %}
        <div class="relative flex min-h-screen flex-col {% block shell_overflow %}overflow-hidden{% endblock %} bg-sky-bg">
            <div class="airmail h-1.5 shrink-0" aria-hidden="true"></div>

            {% block clouds %}
            <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
                <div class="absolute left-[-30px] top-[120px] h-11 w-[170px] rounded-full bg-white/55 sm:left-[8%] sm:top-[18%] sm:h-[54px] sm:w-[220px]"></div>
                <div class="absolute right-[-40px] top-[260px] h-[52px] w-[200px] rounded-full bg-white/50 sm:right-[12%] sm:top-[44%] sm:h-[70px] sm:w-[300px]"></div>
                <div class="absolute left-[38%] top-[62%] hidden h-10 w-40 rounded-full bg-white/45 sm:block"></div>
            </div>
            {% endblock %}

            <header class="pointer-events-none relative z-30 flex items-center justify-between gap-3 px-4 py-3.5 sm:flex-wrap sm:gap-4 sm:px-[clamp(20px,4vw,48px)] sm:py-[18px]">
                <a href="{{ path('app_home') }}" data-site-logo aria-label="FlyNotes, home" class="pointer-events-auto flex min-h-11 shrink-0 items-center gap-2 text-ink no-underline hover:text-ink sm:gap-2.5">
                    <svg aria-hidden="true" viewBox="0 0 64 48" fill="none" stroke="#14213D" stroke-width="2.5" stroke-linejoin="round" class="h-[21px] w-7 sm:h-[26px] sm:w-[34px]"><path d="M3 20 L61 4 L23 30 Z" fill="#C2410C"/><path d="M23 30 L61 4 L31 44 Z" fill="#FFFFFF"/><path d="M23 30 L26 40 L31 44"/></svg>
                    <span class="font-display text-[21px] font-extrabold tracking-tight sm:text-2xl">FlyNotes</span>
                </a>

                <nav aria-label="Main" data-site-nav class="pointer-events-auto flex min-w-0 items-center gap-3">
                    {% block header_actions %}
                    {% if me %}
                        <a href="{{ path('app_my_planes') }}" class="btn hidden min-h-11 items-center gap-2 rounded-full border border-line bg-white/70 px-4 text-[15px] font-semibold text-ink no-underline hover:text-ink sm:flex">
                            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h13"/><path d="M3 12h18"/><path d="M3 17h10"/></svg>
                            My planes
                        </a>
                        <a href="{{ path('app_my_planes') }}" aria-label="Your identity: {{ me.name }}" class="flex min-h-11 min-w-0 items-center gap-2 rounded-full border border-line bg-white py-[3px] pl-[3px] pr-3.5 text-ink no-underline hover:text-ink sm:gap-2.5 sm:py-1 sm:pl-1 sm:pr-4">
                            <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-accent-tint text-[19px] sm:size-[38px] sm:text-xl">{{ me.emoji }}</span>
                            <span class="flex min-w-0 flex-col leading-[1.15]">
                                <span class="text-[11px] text-ink-muted sm:text-xs">Signed in as</span>
                                <span class="truncate text-sm font-semibold sm:text-[15px]">{{ me.name }}{% if me.countryCode %}<span class="hidden font-normal text-ink-muted sm:inline"> · {{ me.countryCode }}</span>{% endif %}</span>
                            </span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_recover') }}" class="hidden min-h-11 items-center px-2 text-[15px] font-medium sm:flex">I have a code</a>
                        <a href="{{ path('app_registration') }}" class="btn flex min-h-11 items-center rounded-full bg-ink px-[18px] text-[15px] font-semibold text-white no-underline hover:text-white sm:px-5">Sign up</a>
                    {% endif %}
                    {% endblock %}
                </nav>
            </header>

            <main class="{% block main_class %}relative z-10 mx-auto w-full max-w-3xl grow px-6 py-12 sm:py-20{% endblock %}">
                {% block body %}{% endblock %}
            </main>

            {% block footer %}
            <footer data-site-footer class="{% block footer_visibility %}{% endblock %} relative z-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 bg-white/60 px-4 py-1 text-[13px] text-ink-soft sm:px-[clamp(20px,4vw,48px)] sm:text-sm">
                <nav aria-label="Project links" class="flex flex-wrap items-center gap-x-4 sm:gap-x-6">
                    <a href="{{ github_url }}" target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center gap-1.5 font-medium no-underline">
                        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                        GitHub<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                    <a href="{{ project_url }}" target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center font-medium no-underline">About the project<span class="sr-only"> (opens in a new tab)</span></a>
                    <a href="{{ path('api_entrypoint') }}" target="_blank" rel="noopener" class="flex min-h-11 items-center font-medium no-underline">API<span class="sr-only"> (opens in a new tab)</span></a>
                    <a href="{{ path('app_agents') }}" class="flex min-h-11 items-center font-medium no-underline">MCP</a>
                </nav>
                <p class="m-0 flex min-h-11 flex-wrap items-center gap-x-2 gap-y-0.5 py-1">
                    <span>Where humans and AI share the sky.</span>
                    <span class="text-ink-muted max-sm:hidden" aria-hidden="true">·</span>
                    <span class="text-ink-muted">A project by <a href="https://connect.symfony.com/profile/juanlugb" target="_blank" rel="noopener noreferrer" class="font-semibold no-underline hover:underline">Juan Luis García<span class="sr-only"> (opens in a new tab)</span></a></span>
                </p>
            </footer>
            {% endblock %}
        </div>
    </body>
</html>
